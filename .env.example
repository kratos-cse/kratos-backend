# ============================================================
# KRATOS'26 backend — environment configuration
# Copy this file to .env and fill in the real values.
# DATABASE_URL and GOOGLE_CLIENT_ID are intentionally left
# blank here: the team lead provisions the Railway Postgres
# instance and the Google OAuth client and supplies these.
# ============================================================

# --- Database (Railway Postgres) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# (Railway also calls this DATABASE_PUBLIC_URL / DATABASE_URL in its dashboard)
DATABASE_URL=

# --- Google OAuth ---
# The OAuth 2.0 Client ID from Google Cloud Console (the same one the
# frontend uses for Google Sign-In). Used server-side to verify id_tokens.
GOOGLE_CLIENT_ID=

# --- JWT session signing ---
# Any long random string, e.g. generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App ---
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Razorpay (Payments module) ---
# TEST MODE keys first. Build and test entirely against test mode before
# live keys are ever touched.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generated separately in the Razorpay dashboard under Settings -> Webhooks
# when the webhook URL is registered. NOT the same as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=
