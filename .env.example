DATABASE_URL=postgresql://user:password@host:port/dbname

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Create OAuth 2.0 Client ID (Web application type)
# Authorized JS Origins:    http://localhost:8000
# Authorized Redirect URIs: http://localhost:8000/docs/oauth2-redirect
GOOGLE_CLIENT_ID=

# ── Super-Admin bootstrap ─────────────────────────────────────────────────────
# Must match the email of a user already in the users table.
# Run: $env:PYTHONPATH="."; python scripts/seed_admin.py   (creates user + admin in one shot)
SUPER_ADMIN_EMAIL=

# ── SMTP (Mailtrap for dev, real SMTP for prod) ───────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=true
EMAIL_DRY_RUN=false

# ── CORS (comma-separated) ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Razorpay (leave blank until payments branch is merged) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
RECEIPT_STORAGE_DIR=./storage/receipts
APP_PUBLIC_BASE_URL=http://localhost:8000
