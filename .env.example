# Database connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/kratos

# Razorpay -- TEST MODE keys first. Build and test entirely against test mode
# before live keys are ever touched.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Generated separately in the Razorpay dashboard under Settings -> Webhooks
# when the webhook URL is registered. NOT the same as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=
