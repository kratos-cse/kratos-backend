# KRATOS'26 Backend Environment Variables

ENVIRONMENT=development

# Database (PostgreSQL URL)
DATABASE_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
RECEIPT_ACCESS_TOKEN_EXPIRE_MINUTES=20

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Super Admin bootstrap
SUPER_ADMIN_EMAIL=

# CORS
CORS_ORIGINS=http://localhost:3000

# SMTP (email delivery & notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=KRATOS'26
SMTP_TLS=true

# Public Base URL
APP_PUBLIC_BASE_URL=http://localhost:8000
